# Copy to .env for local development. Never commit real secrets.

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Optional: use with flutter_dotenv or CI secrets injection
FIREBASE_IOS_BUNDLE_ID=com.cardinalmemorials.lettersToHeaven
FIREBASE_ANDROID_PACKAGE=com.cardinalmemorials.letters_to_heaven
